# Optional cloud vision. Never commit a real .env file.
MOONDREAM_API_KEY=

# stdio (default), http, or streamable-http
TRANSPORT=stdio
HOST=127.0.0.1
PORT=3001

# Required for external HTTP binding/public URLs. Use a randomly generated value.
MCP_AUTH_TOKEN=
# Exact HTTPS gateway origin; no path. Required to allow that Host/Origin.
MCP_PUBLIC_URL=

# Optional nonstandard Resolve scripting paths:
# PYTHONPATH_RESOLVE=C:/ProgramData/Blackmagic Design/DaVinci Resolve/Support/Developer/Scripting/Modules
# RESOLVE_SCRIPT_API=...
# RESOLVE_SCRIPT_LIB=...